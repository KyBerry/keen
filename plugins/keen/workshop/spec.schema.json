{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keen.local/schemas/workshop-spec-v1.json",
  "title": "Keen direction workshop spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session", "context", "questions"],
  "properties": {
    "schema_version": { "const": 1 },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "stage", "eyebrow", "title", "intro", "submit_label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "stage": { "enum": ["product-truth", "direction", "critique"] },
        "eyebrow": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "intro": { "type": "string", "minLength": 1, "maxLength": 500 },
        "submit_label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "product_job", "audience", "primary_action", "constraints"],
      "properties": {
        "product": { "type": "string", "minLength": 1, "maxLength": 120 },
        "product_job": { "type": "string", "minLength": 1, "maxLength": 500 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 400 },
        "primary_action": { "type": "string", "minLength": 1, "maxLength": 240 },
        "constraints": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "prompt", "help", "required", "allow_custom", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["single", "multiple", "text"] },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 240 },
        "help": { "type": "string", "minLength": 1, "maxLength": 500 },
        "required": { "type": "boolean" },
        "allow_custom": { "type": "boolean" },
        "options": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/option" }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "thesis", "fit", "change", "risk", "cost", "specimen"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "thesis": { "type": "string", "minLength": 1, "maxLength": 220 },
        "fit": { "type": "string", "minLength": 1, "maxLength": 320 },
        "change": { "type": "string", "minLength": 1, "maxLength": 320 },
        "risk": { "type": "string", "minLength": 1, "maxLength": 260 },
        "cost": { "type": "string", "minLength": 1, "maxLength": 160 },
        "specimen": { "$ref": "#/$defs/specimen" }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "kicker", "title", "body", "primary_action", "secondary_action",
        "details", "annotation", "style"
      ],
      "properties": {
        "kind": { "enum": ["page", "type", "action", "density", "color", "interaction"] },
        "kicker": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 360 },
        "primary_action": { "type": "string", "maxLength": 80 },
        "secondary_action": { "type": "string", "maxLength": 80 },
        "details": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "annotation": { "type": "string", "maxLength": 160 },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_font", "body_font", "scale", "density", "palette",
            "corners", "alignment", "depth", "motion"
          ],
          "properties": {
            "display_font": { "enum": ["serif", "grotesk", "humanist", "mono"] },
            "body_font": { "enum": ["serif", "grotesk", "humanist", "mono"] },
            "scale": { "enum": ["quiet", "balanced", "dramatic"] },
            "density": { "enum": ["compact", "comfortable", "airy"] },
            "palette": { "enum": ["ink", "blueprint", "warm", "signal", "forest"] },
            "corners": { "enum": ["square", "soft", "round"] },
            "alignment": { "enum": ["left", "split", "center"] },
            "depth": { "enum": ["flat", "lined", "raised"] },
            "motion": { "enum": ["still", "measured", "expressive"] }
          }
        }
      }
    }
  }
}
