{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_truth", "chosen_direction", "prototype", "critique", "durable_decisions"],
  "properties": {
    "product_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job", "audience", "primary_action", "constraints"],
      "properties": {
        "job": { "type": "string" },
        "audience": { "type": "string" },
        "primary_action": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chosen_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "composition", "typography", "density", "color", "interaction", "avoid", "failure_mode", "cost"],
      "properties": {
        "thesis": { "type": "string" },
        "composition": { "type": "string" },
        "typography": { "type": "string" },
        "density": { "type": "string" },
        "color": { "type": "string" },
        "interaction": { "type": "string" },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "failure_mode": { "type": "string" },
        "cost": { "type": "string" }
      }
    },
    "prototype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "real_content", "viewports", "states"],
      "properties": {
        "scope": { "type": "string" },
        "real_content": { "type": "array", "items": { "type": "string" } },
        "viewports": { "type": "array", "items": { "type": "string" } },
        "states": { "type": "array", "items": { "type": "string" } }
      }
    },
    "critique": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "revision", "coverage_gap"],
      "properties": {
        "observed": { "type": "string" },
        "revision": { "type": "string" },
        "coverage_gap": { "type": "string" }
      }
    },
    "durable_decisions": { "type": "array", "items": { "type": "string" } }
  }
}
