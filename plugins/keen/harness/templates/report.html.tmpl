<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" href="data:,">
<title>Keen review — $title</title>
<style>
:root {
  color-scheme: light;
  --surface-base: #f7f4ed;
  --surface-panel: #eee9df;
  --surface-elevated: #fffdf8;
  --input-bg: #e7e1d5;
  --surface-overlay: #fffdf8;
  --ink: #201f1b;
  --ink-muted: #625e55;
  --border-subtle: #d5cdbf;
  --border-strong: #8d8374;
  --accent: #9e3f27;
  --accent-hover: #77301f;
  --focus: #176b72;
  --masthead: #191916;
  --masthead-ink: #f7f4ed;
  --masthead-muted: #c8c0b3;
  --p0: #9f2929;
  --p0-bg: #f6d9d5;
  --p1: #815000;
  --p1-bg: #f3e1b8;
  --p2: #455b60;
  --p2-bg: #dce7e6;
  --success: #276341;
  --code-bg: #eae4d9;
  --mono: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --sans: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --surface-base: #151512;
    --surface-panel: #1d1c18;
    --surface-elevated: #26241f;
    --input-bg: #201f1b;
    --surface-overlay: #2c2923;
    --ink: #f2eee5;
    --ink-muted: #bdb5a8;
    --border-subtle: #403b33;
    --border-strong: #7c7264;
    --accent: #e38a6e;
    --accent-hover: #f1ae98;
    --focus: #79c9cf;
    --masthead: #0d0d0b;
    --masthead-ink: #f7f4ed;
    --masthead-muted: #bdb5a8;
    --p0: #ffb4aa;
    --p0-bg: #4d1716;
    --p1: #ffd186;
    --p1-bg: #402b09;
    --p2: #b9d7d8;
    --p2-bg: #24383a;
    --success: #8bd5a9;
    --code-bg: #302d27;
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--surface-base);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 15px;
  line-height: 1.55;
}
a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 3px; }
a:hover { color: var(--accent-hover); }
a:focus-visible, button:focus-visible, [tabindex]:focus-visible {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}
code { font-family: var(--mono); font-size: .9em; }
.skip-link {
  position: fixed;
  left: 16px;
  top: 12px;
  z-index: 100;
  min-height: 44px;
  padding: 11px 16px;
  background: var(--surface-overlay);
  color: var(--ink);
  border: 2px solid var(--focus);
  transform: translateY(-160%);
}
.skip-link:focus { transform: translateY(0); }
.masthead {
  background: var(--surface-base);
  color: var(--ink);
  border-bottom: 1px solid var(--border-strong);
}
.masthead-inner {
  width: min(1480px, 100%);
  margin: 0 auto;
  padding: 28px clamp(20px, 5vw, 72px) 24px;
}
.brand-line {
  margin-bottom: 8px;
  color: var(--ink-muted);
  font-size: 12px;
  font-weight: 650;
}
.masthead h1 {
  max-width: 980px;
  margin: 0;
  font-size: clamp(26px, 4vw, 38px);
  font-weight: 650;
  letter-spacing: -.025em;
  line-height: 1.2;
  overflow-wrap: anywhere;
}
.run-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 28px;
  margin: 20px 0 0;
  color: var(--ink-muted);
  font-size: 13px;
}
.run-meta div { display: flex; gap: 8px; }
.run-meta dt { font-size: 11px; font-weight: 650; }
.run-meta dd { margin: 0; }
.verdict-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(150px, 220px));
  width: fit-content;
  margin-top: 20px;
  border-top: 1px solid var(--border-strong);
}
.metric {
  min-height: 66px;
  padding: 12px 22px 0 0;
}
.metric-label {
  display: block;
  margin-bottom: 4px;
  color: var(--ink-muted);
  font-size: 11px;
}
.metric-value { font-size: 22px; font-weight: 700; letter-spacing: -.02em; }
.verdict-strip[data-grade="A"] .metric:first-child .metric-value { color: var(--success); }
.verdict-strip[data-grade="B"] .metric:first-child .metric-value { color: var(--success); }
.verdict-strip[data-grade="C"] .metric:first-child .metric-value,
.verdict-strip[data-grade="D"] .metric:first-child .metric-value { color: var(--p1); }
.verdict-strip[data-grade="F"] .metric:first-child .metric-value { color: var(--p0); }
.verdict-strip[data-grade="INCOMPLETE"] .metric:first-child .metric-value { color: var(--p2); font-size: 18px; }
.report-shell {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: clamp(28px, 5vw, 80px);
  width: min(1480px, 100%);
  margin: 0 auto;
  padding: 0 clamp(20px, 5vw, 72px) 80px;
}
.report-nav {
  position: sticky;
  top: 24px;
  align-self: start;
  padding-top: 52px;
}
.report-nav .nav-label { margin: 0 0 10px; color: var(--ink-muted); font-size: 12px; font-weight: 650; }
.report-nav ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border-strong); }
.report-nav li { border-bottom: 1px solid var(--border-subtle); }
.report-nav a {
  display: block;
  min-height: 44px;
  padding: 12px 0;
  color: var(--ink);
  font-weight: 600;
  text-decoration: none;
}
.report-nav a:hover { color: var(--accent); }
main { min-width: 0; padding-top: 52px; }
.chapter { margin: 0 0 76px; scroll-margin-top: 28px; }
.chapter-head {
  margin-bottom: 18px;
  padding-top: 12px;
  border-top: 1px solid var(--ink);
}
.chapter h2 { margin: 0; font-size: 20px; letter-spacing: -.01em; line-height: 1.3; }
.chapter h3 { margin: 30px 0 10px; font-size: 17px; }
.summary-block {
  padding: 0;
}
.summary-block h3, .summary-block h4 { margin: 26px 0 10px; }
.summary-block p { max-width: 78ch; margin: 8px 0; }
.summary-block code { padding: 2px 5px; background: var(--code-bg); }
.summary-block pre { overflow: auto; padding: 16px; background: var(--code-bg); border: 1px solid var(--border-subtle); }
.summary-block ul { padding-left: 22px; }
.summary-block table { width: 100%; border-collapse: collapse; margin: 18px 0; }
.summary-block th, .summary-block td { padding: 9px 10px; border-bottom: 1px solid var(--border-subtle); text-align: left; }
.summary-block th { color: var(--ink-muted); font: 700 11px/1.3 var(--mono); text-transform: uppercase; }
.verdict-lead { max-width: 850px; }
.verdict-kicker {
  margin: 0 0 8px;
  color: var(--ink-muted);
  font-size: 12px;
  font-weight: 650;
}
.verdict-copy { margin: 0; font-size: clamp(19px, 3vw, 26px); line-height: 1.35; letter-spacing: -.015em; }
.verdict-facts {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin: 30px 0 0;
  border-top: 1px solid var(--border-strong);
  border-bottom: 1px solid var(--border-strong);
}
.verdict-facts div { padding: 14px 14px 16px 0; }
.verdict-facts dt { color: var(--ink-muted); font: 700 10px/1.3 var(--mono); text-transform: uppercase; letter-spacing: .06em; }
.verdict-facts dd { margin: 7px 0 0; font-size: 19px; font-weight: 700; }
.verdict-guidance { max-width: 68ch; margin: 22px 0 8px; }
.verdict-link { display: inline-block; min-height: 44px; padding: 10px 0; color: var(--accent); font-weight: 700; text-underline-offset: 4px; }
table.findings {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
table.findings th, table.findings td { padding: 12px 10px; border-bottom: 1px solid var(--border-subtle); text-align: left; vertical-align: top; }
table.findings th {
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--surface-base);
  color: var(--ink-muted);
  cursor: pointer;
  font: 700 10px/1.3 var(--mono);
  letter-spacing: .05em;
  text-transform: uppercase;
}
table.findings .sort-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  min-height: 32px;
  padding: 0;
  color: inherit;
  background: transparent;
  border: 0;
  font: inherit;
  letter-spacing: inherit;
  text-align: left;
  text-transform: inherit;
  cursor: pointer;
}
table.findings tbody tr:hover { background: var(--surface-panel); }
table.findings th[aria-sort="ascending"] .sort-indicator::after { content: "▲"; }
table.findings th[aria-sort="descending"] .sort-indicator::after { content: "▼"; }
table.findings th:not([aria-sort]) .sort-indicator::after { content: "↕"; color: var(--ink-muted); }
.row-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  margin-left: 6px;
  font-weight: 700;
}
.badge {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  padding: 3px 8px;
  border: 1px solid currentColor;
  border-radius: 2px;
  font: 750 11px/1 var(--mono);
}
.badge-P0 { color: var(--p0); background: var(--p0-bg); }
.badge-P1 { color: var(--p1); background: var(--p1-bg); }
.badge-P2 { color: var(--p2); background: var(--p2-bg); }
.gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 500px), 1fr)); gap: 28px; }
.gallery figure { margin: 0; background: var(--surface-elevated); border: 1px solid var(--border-subtle); }
.gallery figcaption {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  min-height: 62px;
  padding: 10px 14px;
  border-bottom: 1px solid var(--border-subtle);
}
.vp-label { font-weight: 700; }
.img-wrap { max-height: 680px; overflow: auto; background: var(--input-bg); }
.gallery img { display: block; width: 100%; height: auto; }
.toggle-btn {
  min-width: 44px;
  min-height: 44px;
  padding: 8px 12px;
  background: var(--surface-elevated);
  color: var(--ink);
  border: 1px solid var(--border-strong);
  border-radius: 2px;
  font: 700 12px/1 var(--mono);
  cursor: pointer;
}
.toggle-btn:hover, .toggle-btn[aria-pressed="true"] { background: var(--ink); color: var(--surface-base); }
.component-list { border-top: 1px solid var(--border-strong); }
.component-card {
  display: grid;
  grid-template-columns: minmax(160px, 230px) minmax(0, 1fr);
  gap: 22px;
  padding: 22px 0;
  border-bottom: 1px solid var(--border-subtle);
  scroll-margin-top: 20px;
}
.component-card:target { background: var(--surface-panel); box-shadow: 12px 0 0 var(--surface-panel), -12px 0 0 var(--surface-panel); }
.component-card img { width: 100%; max-height: 180px; object-fit: contain; background: var(--input-bg); border: 1px solid var(--border-subtle); }
.ckind { margin-bottom: 5px; font-size: 16px; font-weight: 700; }
.cbox { color: var(--ink-muted); font: 11px/1.5 var(--mono); }
.cfind { margin: 14px 0 0; padding: 0; list-style: none; }
.cfind li { margin: 9px 0; }
.swatches { display: flex; flex-wrap: wrap; gap: 8px; }
.swatch {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 38px;
  padding: 6px 9px;
  background: var(--surface-elevated);
  border: 1px solid var(--border-subtle);
  font-family: var(--mono);
  font-size: 11px;
}
.chip { width: 24px; height: 24px; border: 1px solid var(--border-strong); }
.count { color: var(--ink-muted); }
.scale-row { display: flex; align-items: baseline; gap: 18px; padding: 6px 0; border-bottom: 1px solid var(--border-subtle); }
.scale-row .sample { min-width: 84px; font-weight: 650; line-height: 1.2; }
.scale-row .meta { color: var(--ink-muted); font: 11px/1.3 var(--mono); }
.kv-grid { display: grid; grid-template-columns: minmax(180px, max-content) 1fr; gap: 8px 22px; }
.kv-grid dt { color: var(--ink-muted); font-weight: 650; }
.kv-grid dd { margin: 0; font-family: var(--mono); }
.placeholder, .empty { color: var(--ink-muted); }
.placeholder { padding: 18px; background: var(--surface-panel); border-left: 3px solid var(--border-strong); }
@media (max-width: 850px) {
  .masthead-inner { padding-inline: 20px; }
  .verdict-strip { width: 100%; grid-template-columns: 1fr 1fr; }
  .report-shell { display: block; padding-inline: 20px; }
  .report-nav { position: static; padding-top: 20px; overflow-x: visible; }
  .report-nav .nav-label { display: none; }
  .report-nav ol { display: flex; flex-wrap: wrap; width: auto; border-top: 0; }
  .report-nav li { border-bottom: 0; }
  .report-nav a { grid-template-columns: auto 1fr; padding: 12px 14px; border-bottom: 1px solid var(--border-subtle); }
  main { padding-top: 36px; }
  .chapter { margin-bottom: 58px; }
  .summary-block { padding-left: 16px; }
  .verdict-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .component-card { grid-template-columns: 1fr; }
  .component-card img { width: min(100%, 360px); }
  .kv-grid { grid-template-columns: 1fr; }
  .kv-grid dd { margin-bottom: 8px; }
  #findings { overflow-x: visible; }
  table.findings, table.findings thead, table.findings tbody { display: block; width: 100%; }
  table.findings thead tr {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    padding: 8px 0;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }
  table.findings thead th {
    position: static;
    flex: 1 1 112px;
    padding: 0;
    border: 0;
    background: transparent;
  }
  table.findings .sort-button { min-height: 44px; padding: 8px 0; }
  table.findings tbody tr {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 4px 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  table.findings tbody td {
    display: block;
    grid-column: 2;
    padding: 0;
    border: 0;
    overflow-wrap: anywhere;
  }
  table.findings tbody td:first-child {
    grid-column: 1;
    grid-row: 1 / span 4;
  }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
@media print {
  .masthead { color: var(--ink); background: var(--surface-base); border-color: var(--ink); }
  .report-shell { display: block; padding: 0; }
  .report-nav, .toggle-btn { display: none; }
  main { padding: 18px; }
  .chapter, .component-card, .gallery figure { break-inside: avoid; }
  .img-wrap { max-height: none; overflow: visible; }
  a { color: inherit; text-decoration: none; }
}
</style>
</head>
<body>
<a class="skip-link" href="#main">Skip to report</a>
<header class="masthead" role="banner">
  <div class="masthead-inner">
    <div class="brand-line">Keen review</div>
    <h1>$title</h1>
    <dl class="run-meta" aria-label="Run metadata">
      <div><dt>Captured</dt><dd>$captured_at</dd></div>
      <div><dt>System</dt><dd>$target_system</dd></div>
    </dl>
    <div class="verdict-strip" data-grade="$grade" aria-label="Review verdict">
      <div class="metric"><span class="metric-label">Grade</span><span class="metric-value">$grade</span></div>
      <div class="metric"><span class="metric-label">Damage</span><span class="metric-value">$damage</span></div>
    </div>
  </div>
</header>
<div class="report-shell">
  <nav class="report-nav" aria-label="Report contents">
    <p class="nav-label">Contents</p>
    <ol>
      <li><a href="#summary">Verdict</a></li>
      <li><a href="#findings">Findings</a></li>
      <li><a href="#gallery">Screens</a></li>
      <li><a href="#components">Evidence</a></li>
      <li><a href="#tokens">Tokens</a></li>
    </ol>
  </nav>
  <main id="main" tabindex="-1">
    <section class="chapter" id="summary" aria-labelledby="summary-h">
      <header class="chapter-head"><h2 id="summary-h">Verdict</h2></header>
      <div class="summary-block">$summary_html</div>
    </section>
    <section class="chapter" id="findings" aria-labelledby="findings-h">
      <header class="chapter-head"><h2 id="findings-h">Priority findings</h2></header>
      $findings_table_html
    </section>
    <section class="chapter" id="gallery" aria-labelledby="gallery-h">
      <header class="chapter-head"><h2 id="gallery-h">Captured screens</h2></header>
      $gallery_html
    </section>
    <section class="chapter" id="components" aria-labelledby="components-h">
      <header class="chapter-head"><h2 id="components-h">Component evidence</h2></header>
      $components_html
    </section>
    <section class="chapter" id="tokens" aria-labelledby="tokens-h">
      <header class="chapter-head"><h2 id="tokens-h">Observed tokens</h2></header>
      $tokens_html
    </section>
  </main>
</div>
<script>
(function () {
  function rankOf(row, idx) {
    var cell = row.children[idx];
    if (!cell) return "";
    var value = cell.getAttribute("data-sort-value");
    return value !== null ? value : (cell.textContent || "").trim();
  }
  document.querySelectorAll("table.findings").forEach(function (table) {
    var body = table.tBodies[0];
    if (!body) return;
    table.querySelectorAll("thead th").forEach(function (heading, index) {
      var control = heading.querySelector(".sort-button");
      if (!control) return;
      function sort() {
        var ascending = heading.getAttribute("aria-sort") !== "ascending";
        table.querySelectorAll("thead th").forEach(function (item) { item.removeAttribute("aria-sort"); });
        heading.setAttribute("aria-sort", ascending ? "ascending" : "descending");
        var numeric = heading.getAttribute("data-sort-type") === "number";
        var rows = Array.prototype.slice.call(body.rows);
        rows.sort(function (a, b) {
          var left = rankOf(a, index), right = rankOf(b, index);
          if (numeric) { left = parseFloat(left) || 0; right = parseFloat(right) || 0; }
          if (left < right) return ascending ? -1 : 1;
          if (left > right) return ascending ? 1 : -1;
          return 0;
        });
        rows.forEach(function (row) { body.appendChild(row); });
      }
      control.addEventListener("click", sort);
    });
  });
  document.querySelectorAll("[data-toggle-target]").forEach(function (button) {
    button.addEventListener("click", function () {
      var target = document.getElementById(button.getAttribute("data-toggle-target"));
      if (!target) return;
      var annotated = button.getAttribute("aria-pressed") !== "true";
      button.setAttribute("aria-pressed", annotated ? "true" : "false");
      button.textContent = annotated ? "Show raw" : "Show annotated";
      target.querySelectorAll("[data-variant]").forEach(function (image) {
        var variant = image.getAttribute("data-variant");
        image.hidden = (annotated && variant !== "annotated") || (!annotated && variant !== "raw");
      });
    });
  });
})();
</script>
</body>
</html>
